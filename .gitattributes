# Deterministic text bytes across Windows, macOS and Linux. Release package
# hashes use Git blobs; generated public outputs also retain LF on checkout.
* text=auto
.gitattributes text eol=lf
docs/evidence/** text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.md text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.csv text eol=lf
*.sha256 text eol=lf
*.yml text eol=lf
*.xml text eol=lf
docs/momm/llms.txt text eol=lf
# Captions are byte-hashed delivery assets, including their original line endings.
*.vtt -text
docs/momm/brands/*.svg text eol=lf
*.png binary
*.jpg binary
*.mp4 binary
*.flac binary
*.wav binary
